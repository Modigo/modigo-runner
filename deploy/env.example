# Modigo Runner Environment Configuration
# Copy to /etc/modigo-runner/env and fill in values

# Server
PORT=8080
# Comma-separated list of exact origins allowed to open WebSocket connections.
# Add your local dev origin if you test from localhost, e.g.:
# ALLOWED_ORIGINS=https://modigo.online,https://www.modigo.online,http://localhost:5173
ALLOWED_ORIGINS=https://modigo.online,https://www.modigo.online

# Docker
DOCKER_SOCKET=/var/run/docker.sock
IMAGE_PREFIX=modigo-runner-
EXEC_TIMEOUT=30s

# Resource Limits
# SIZING (see EC2_DEPLOYMENT.md "Capacity planning"): these defaults assume a
# 2 vCPU / 8GB box. The BINDING constraint is CPU, not RAM: each container gets
# CPU_QUOTA/100000 of a core, and concurrent runs share only 2 physical cores.
# MAX_CONCURRENT=12 lets ~40-60 bursty learners work comfortably; runs queue
# (bounded, fail-fast) beyond that instead of thrashing the host.
MAX_MEMORY=384m
CPU_QUOTA=50000
MAX_PID=64
MAX_CONCURRENT=12

# Pool
POOL_SIZE=3

# Rate Limiting
RATE_LIMIT_RPS=10
RATE_LIMIT_DAILY=10000

# Auth — must match RUNNER_SECRET in Laravel .env
AUTH_SECRET=your-shared-secret-here

# Stats endpoint — set to protect /stats from unauthorized access
STATS_KEY=your-stats-key-here
