# Caddyfile for Modigo Runner
# Place this at /etc/caddy/Caddyfile on the VPS
# Caddy handles TLS automatically — no certbot needed

runner.modigo.online {
    # Rate limiting — 100 requests per second per IP
    rate_limit {
        zone runner_api {
            key    {remote_host}
            events 100
            window 1s
        }
    }

    # Proxy to the Go runner (Caddy auto-upgrades WebSocket connections)
    reverse_proxy localhost:8080 {
        # Pass real client IP (X-Forwarded-For and X-Forwarded-Proto
        # are set automatically by Caddy's reverse_proxy)
        header_up X-Real-IP {remote_host}

        # Health check for load balancer / monitoring
        health_uri /health
        health_interval 10s
        health_timeout 5s

        # Timeouts
        transport http {
            read_timeout 60s
            write_timeout 60s
        }
    }

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # Logging
    log {
        output file /var/log/caddy/runner.log {
            roll_size 100mb
            roll_keep 5
        }
        format json
    }
}
