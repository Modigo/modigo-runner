# Modigo Runner Configuration
# Copy this to .env and edit

# Server
PORT=8080
ALLOWED_ORIGINS=*

# Docker
DOCKER_SOCKET=/var/run/docker.sock
IMAGE_PREFIX=modigo-runner-
MAX_CONCURRENT=50

# Execution limits
EXEC_TIMEOUT=30s
MAX_MEMORY=256m
CPU_QUOTA=50000
MAX_PID=64

# Container pool (pre-warmed containers for instant startup)
POOL_SIZE=3

# Rate limiting
RATE_LIMIT_RPS=10
RATE_LIMIT_DAILY=10000

# Auth — must match the JWT secret configured in your Laravel backend
# Leave empty to disable auth (for local development only)
AUTH_SECRET=
